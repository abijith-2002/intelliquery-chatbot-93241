{"is_source_file": true, "format": "Python", "description": "This file defines a module for extracting and processing text and metadata from various document formats (.txt, .pdf, .docx, .xlsx). It includes functions for extracting text, processing Excel files to generate metadata and store data as Parquet, as well as auxiliary functions for metadata extraction, cleanup, and session management.", "external_files": ["pdfminer.high_level", "docx", "openpyxl", "pandas", "io", "json", "logging", "pathlib", "datetime", "re"], "external_methods": ["pdfminer.high_level.extract_text", "docx.Document", "openpyxl.load_workbook", "pandas.read_excel", "pandas.ExcelFile", "pandas.DataFrame.to_parquet", "pandas.api.types.is_numeric_dtype", "pandas.api.types.is_datetime64_any_dtype", "pandas.api.types.is_categorical_dtype"], "published": ["extract_text_from_bytes", "process_excel_for_session", "get_session_excel_metadata", "load_session_parquet_data", "summarize_text_preview"], "classes": [], "methods": [{"name": "Tuple[str,Optional[str]] extract_text_from_bytes(filename: str, content: bytes)", "description": "Extracts text from a file given its filename and raw bytes. Supports .txt, .pdf, .docx, and .xlsx formats.", "scope": "", "scopeKind": ""}, {"name": "Tuple[Dict[str,Any],Optional[str]] process_excel_for_session( filename: str, content: bytes, session_id: str )", "description": "Processes an Excel file content for a specific session, extracting sheet data, saving as Parquet, and generating metadata.", "scope": "", "scopeKind": ""}, {"name": "List[Dict[str,Any]] get_session_excel_metadata(session_id: str)", "description": "Retrieves stored metadata for all Excel files associated with a given session.", "scope": "", "scopeKind": ""}, {"name": "Optional[pd.DataFrame] load_session_parquet_data(session_id: str, parquet_filename: str)", "description": "Loads specific Parquet data from a session for further analysis.", "scope": "", "scopeKind": ""}, {"name": "str summarize_text_previ